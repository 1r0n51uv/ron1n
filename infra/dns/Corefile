# Zona DOMINIO (home.ron1n.space): ogni nome risponde con l'IP Tailscale del
# server, dove Caddy smista i siti per nome. I client della tailnet mandano
# qui solo le domande su questa zona (split DNS di Tailscale): le altre non
# le risolve. Su internet la zona non ha record. Spec SETUP-005, SETUP-008.
{$DOMINIO} {
	template IN A {
		answer "{{ .Name }} 60 IN A {$TS_IP}"
	}
	# Niente IPv6 né altri tipi (HTTPS, MX...): risposta vuota, non errore,
	# così i client passano subito all'IPv4.
	template ANY ANY {
		rcode NOERROR
	}
	errors
}
