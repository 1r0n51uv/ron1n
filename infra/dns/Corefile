# Zona ron1n.home: ogni nome risponde con l'IP Tailscale del server, dove
# Caddy smista i siti per nome. I client della tailnet mandano qui solo le
# domande su ron1n.home (split DNS di Tailscale): le altre zone non le
# risolve. Spec SETUP-005.
ron1n.home {
	template IN A {
		answer "{{ .Name }} 60 IN A {$TS_IP}"
	}
	# Niente IPv6 né altri tipi (HTTPS, MX...): risposta vuota, non errore,
	# così i client passano subito all'IPv4.
	template ANY ANY {
		rcode NOERROR
	}
	errors
}
