# Copia in .env e adatta. Utente e gruppo proprietari dei file (`id` sul
# server).
PUID=1000
PGID=1000
TZ=Europe/Rome

# Utente e password per entrare nel desktop (autenticazione HTTP del
# container). Cambiali prima del primo avvio.
CUSTOM_USER=ron1n
PASSWORD=cambiami

# Titolo della scheda del browser.
TITLE=ron1n desktop
