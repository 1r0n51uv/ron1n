# Nomi interni, raggiungibili via Tailscale. TLS interno di Caddy finché
# non c'è un dominio vero.
{
	local_certs
}

status.ron1n.home {
	reverse_proxy uptime-kuma:3001
}

# Web UI e Web API di qBittorrent (stack torrent). Solo tailnet.
torrent.ron1n.home {
	reverse_proxy qbittorrent:8080
}

# Interfaccia web di Glances (stack glances, rete dell'host). Solo tailnet.
glances.ron1n.home {
	reverse_proxy host.docker.internal:61208
}

# Desktop Linux nel browser (stack webtop). Solo tailnet.
desktop.ron1n.home {
	reverse_proxy webtop:3000
}
