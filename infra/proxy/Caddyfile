# Nomi interni, raggiungibili via Tailscale. TLS interno di Caddy finché
# non c'è un dominio vero.
{
	local_certs
}

# Certificato radice di Caddy, da installare sui client (iPhone compreso)
# perché i siti *.ron1n.home siano attendibili. In HTTP, perché prima di
# installarlo l'HTTPS dà errore; anche in HTTPS, perché Safari passa da solo
# a https: lì si accetta l'avviso e si scarica. Solo tailnet. Spec SETUP-006.
ca.ron1n.home, http://ca.ron1n.home {
	root * /data/caddy/pki/authorities/local
	rewrite * /root.crt
	# Con questo tipo Safari su iOS propone di installare il profilo.
	header Content-Type application/x-x509-ca-cert
	file_server
}

# Dashboard ron1nOS (stack ron1nos): SPA e API /api/v1. Solo tailnet.
ron1n.home {
	reverse_proxy ron1nos:8080
}

status.ron1n.home {
	reverse_proxy uptime-kuma:3001
}

# Web UI e Web API di qBittorrent (stack torrent). Solo tailnet.
torrent.ron1n.home {
	reverse_proxy qbittorrent:8080
}

# Interfaccia web di Glances (stack glances, rete dell'host). Solo tailnet.
glances.ron1n.home {
	reverse_proxy host.docker.internal:61208
}

# Desktop Linux nel browser (stack webtop). Solo tailnet.
desktop.ron1n.home {
	reverse_proxy webtop:3000
}
