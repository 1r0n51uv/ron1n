# Nomi privati sotto DOMINIO (home.ron1n.space), raggiungibili solo dalla
# tailnet: li risolve lo stack dns, su internet non esistono. Certificati
# Let's Encrypt con la verifica DNS-01 su Cloudflare: validi su ogni client
# senza installare niente, e con il wildcard i nomi dei servizi non
# finiscono nei registri pubblici dei certificati. Spec SETUP-008.
{$DOMINIO}, *.{$DOMINIO} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		# Il TXT della verifica si controlla su un DNS pubblico.
		resolvers 1.1.1.1
	}

	# Dashboard ron1nOS (stack ron1nos): SPA e API /api/v1.
	@home host {$DOMINIO}
	handle @home {
		reverse_proxy ron1nos:8080
	}

	@status host status.{$DOMINIO}
	handle @status {
		reverse_proxy uptime-kuma:3001
	}

	# Web UI e Web API di qBittorrent (stack torrent).
	@torrent host torrent.{$DOMINIO}
	handle @torrent {
		reverse_proxy qbittorrent:8080
	}

	# Interfaccia web di Glances (stack glances, rete dell'host).
	@glances host glances.{$DOMINIO}
	handle @glances {
		reverse_proxy host.docker.internal:61208
	}

	# IPA delle app iOS compilate sul server (stack ios), da aprire con
	# SideStore. Spec IOSB-002.
	@ios host ios.{$DOMINIO}
	handle @ios {
		reverse_proxy ios-builds:80
	}

	# Un nome che non è di nessun servizio.
	handle {
		abort
	}
}
