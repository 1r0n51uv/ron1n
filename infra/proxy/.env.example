# Zona dei nomi privati: i siti sono DOMINIO e *.DOMINIO, risolti solo dallo
# stack dns nella tailnet. Spec SETUP-008.
DOMINIO=home.ron1n.space
# Token API di Cloudflare per la verifica DNS-01 dei certificati: permesso
# "Zone > DNS > Edit" solo sulla zona ron1n.space. Senza, niente HTTPS.
CF_API_TOKEN=
