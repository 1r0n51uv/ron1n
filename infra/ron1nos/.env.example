# Copia in .env e adatta. Le credenziali restano nel backend: il browser e
# l'app iOS non le vedono mai.

# Login della dashboard (ron1nOS docs/specs/auth.md): hash della password,
# generato con
#   docker compose exec ron1nos node dist-server/auth/hash-cli.js
# Tra apici singoli, per via dei $. Senza, il login è spento e la
# dashboard è aperta a chi è nella tailnet.
# AUTH_PASSWORD_HASH='scrypt$32768$8$1$...'

# Web API di qBittorrent (stack torrent, stessa rete proxy). Utente e
# password sono gli stessi QBT_USERNAME/QBT_PASSWORD del .env di torrent.
QBT_URL=http://qbittorrent:8080
QBT_USERNAME=admin
QBT_PASSWORD=admin

# Secondi di attesa dei metadati di un magnet prima di proporre Riprova.
# METADATA_WAIT_SECONDS=60

# Postgres condiviso (stack infra/postgres, rete db), per il modulo
# Nutrizione. La password è RON1NOS_DB_PASSWORD del .env di postgres. Le
# tabelle si creano da sole all'avvio.
DATABASE_URL=postgres://ron1nos:cambiami-ron1nos@postgres:5432/ron1nos

# Account YAZIO per il modulo Nutrizione. Senza tutte queste variabili la
# sincronizzazione resta spenta e il diario vive solo in ron1nOS. Serve un
# account con email e password: se entri con Apple o Google, imposta prima
# una password nell'app YAZIO.
# YAZIO_USERNAME=
# YAZIO_PASSWORD=
# Chiavi pubbliche dell'app YAZIO: se YAZIO le cambia, si aggiornano qui.
# YAZIO_CLIENT_ID=1_4hiybetvfksgw40o0sog4s884kwc840wwso8go4k8c04goo4c
# YAZIO_CLIENT_SECRET=6rok2m65xuskgkgogw40wkkk8sw0osg84s8cggsc4woos4s8o
# Chiave con cui ron1nOS cifra i token di YAZIO in Postgres: una frase lunga
# e casuale (openssl rand -base64 32). Se cambia, rifà il login.
# YAZIO_TOKEN_KEY=
