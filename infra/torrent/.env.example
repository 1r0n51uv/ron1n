# Copia in .env e adatta. Utente e gruppo proprietari dei file scaricati
# (`id` sul server).
PUID=1000
PGID=1000
TZ=Europe/Rome

# Cartella dei download sull'host, montata come /downloads nel container.
DOWNLOADS_DIR=/srv/downloads

# Utente e password della Web UI, applicati a ogni avvio da
# init/10-webui-credentials. Le stesse vanno nel .env della dashboard
# ron1nOS. Cambiali se la dashboard o la Web UI diventano raggiungibili
# da fuori della tailnet.
QBT_USERNAME=admin
QBT_PASSWORD=admin

# Porta BitTorrent in ingresso (TCP e UDP). Per essere un nodo attivo va
# inoltrata anche sul router.
TORRENTING_PORT=6881
