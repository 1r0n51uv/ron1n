#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Imposta utente e password della Web UI di qBittorrent da QBT_USERNAME e
# QBT_PASSWORD (nel .env) a ogni avvio, prima che parta qBittorrent.
# qBittorrent salva solo l'hash PBKDF2-SHA512 della password, quindi
# lo calcoliamo qui con lo stesso formato.

if [[ -z ${QBT_USERNAME} || -z ${QBT_PASSWORD} ]]; then
    echo "[webui-credentials] QBT_USERNAME o QBT_PASSWORD mancanti, salto"
    exit 0
fi

CONF=/config/qBittorrent/qBittorrent.conf python3 - <<'PY'
import base64, hashlib, os, re

conf = os.environ["CONF"]
user = os.environ["QBT_USERNAME"]
salt = os.urandom(16)
key = hashlib.pbkdf2_hmac("sha512", os.environ["QBT_PASSWORD"].encode(), salt, 100_000, 64)
pbkdf2 = f'"@ByteArray({base64.b64encode(salt).decode()}:{base64.b64encode(key).decode()})"'

with open(conf, encoding="utf-8") as f:
    text = f.read()
if "[Preferences]" not in text:
    text += "\n[Preferences]\n"
for k, v in (("WebUI\\Username", user), ("WebUI\\Password_PBKDF2", pbkdf2)):
    line = f"{k}={v}"
    pattern = re.compile("^" + re.escape(k) + "=.*$", re.M)
    if pattern.search(text):
        text = pattern.sub(lambda _: line, text)
    else:
        text = text.replace("[Preferences]\n", f"[Preferences]\n{line}\n", 1)
with open(conf, "w", encoding="utf-8") as f:
    f.write(text)
print(f"[webui-credentials] utente Web UI: {user}")
PY
