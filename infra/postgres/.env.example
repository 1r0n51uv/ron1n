# Copia in .env e cambia tutte le password. Il .env non è versionato.

# Superutente di Postgres, usato solo per amministrazione.
POSTGRES_PASSWORD=cambiami

# Database e utente di ron1nOS (modulo Nutrizione). La stessa password va
# in DATABASE_URL nel .env di infra/ron1nos.
RON1NOS_DB_PASSWORD=cambiami-ron1nos
