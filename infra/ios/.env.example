# Utente e gruppo proprietari dei file in IOS_DIR (`id` sul server).
PUID=1000
PGID=1000

# Cartella sull'host per Xcode.xip, l'SDK iOS, i sorgenti e le IPA. Pesa
# diversi GB: va fuori da /var.
IOS_DIR=/srv/ron1n-ios

# Repo dell'app da compilare.
IOS_REPO=https://github.com/1r0n51uv/ron1nos-ios.git

# Token GitHub per clonare un repo privato: fine-grained, solo su quel
# repo, permesso Contents in sola lettura. Vuoto per un repo pubblico.
GITHUB_TOKEN=

# Indirizzo pubblico della pagina delle IPA, per i link nella source di
# SideStore (IOSB-003).
IOS_URL=https://ios.ron1n.space

# Ogni quanti secondi ios-autobuild guarda se main ha un commit nuovo.
IOS_INTERVALLO=300
